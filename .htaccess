# D'Faria Gastronomia e Eventos — configuração para HostGator (Apache)
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Sempre https e sem www (mesmo endereço oficial informado ao Google)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dfariagastronomia.com.br%{REQUEST_URI} [R=301,L,NE]

# Endereço com barra no final -> sem barra
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Endereços antigos
RewriteRule ^nossos-momentos$ /galeria [R=301,L]
RewriteRule ^frios-finger-food$ /frios-e-finger-food [R=301,L]
RewriteRule ^38-anos-de-experi(e|ê|%C3%AA)ncia$ /o-dfaria [R=301,L,NC]

# Páginas: /eventos -> eventos.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
</IfModule>
