# D'Faria Gastronomia e Eventos — configuração para HostGator (Apache)
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Sempre https e sem www (mesmo endereço oficial informado ao Google)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dfariagastronomia.com.br%{REQUEST_URI} [R=301,L,NE]

# --- Incidente de indexação de 26/11/2026 (ver .github/travas/verificar-seo-no-ar.mjs) ---
# Estas regras ficam ANTES da regra da barra para responder em 1 salto só.

# Páginas regionais do site antigo (jul-set/2026). A pasta /regioes-atendidas/ ainda
# existe no servidor; com "DirectorySlash Off" ela dava 403 e, com barra, 301 -> 403.
# Cada uma vai para a página atual equivalente (com e sem barra, e com /index.html).
RewriteRule ^regioes-atendidas(/|/index\.html)?$ /regioes [R=301,L]
RewriteRule ^regioes-atendidas/cesario-lange(/|/index\.html)?$ /buffet-em-ces\%C3\%A1rio-lange [R=301,L,NE]
RewriteRule ^regioes-atendidas/tatui(/|/index\.html)?$ /buffet-em-tatu\%C3\%AD [R=301,L,NE]
RewriteRule ^regioes-atendidas/tiete(/|/index\.html)?$ /buffet-em-tiete [R=301,L]
RewriteRule ^regioes-atendidas/conchas(/|/index\.html)?$ /buffet-em-conchas [R=301,L]
RewriteRule ^regioes-atendidas/cerquilho(/|/index\.html)?$ /buffet-em-cerquilho [R=301,L]
RewriteRule ^regioes-atendidas/pereiras(/|/index\.html)?$ /buffet-em-pereiras [R=301,L]
RewriteRule ^regioes-atendidas/porangaba(/|/index\.html)?$ /buffet-em-porangaba [R=301,L]
RewriteRule ^regioes-atendidas/colina-das-estrelas(/|/index\.html)?$ /colina-das-estrelas [R=301,L]
RewriteRule ^regioes-atendidas/condominio-jatoba-cesario-lange(/|/index\.html)?$ /buffet-condom\%C3\%ADnio-jatob\%C3\%A1 [R=301,L,NE]
RewriteRule ^regioes-atendidas/village-manaca-cesario-lange(/|/index\.html)?$ /buffet-novillage-manac\%C3\%A1 [R=301,L,NE]
# Cidades sem página própria hoje -> página de regiões
RewriteRule ^regioes-atendidas/(sorocaba|itapetininga|boituva|laranjal-paulista)(/|/index\.html)?$ /regioes [R=301,L]

# Rotas internas do React antigo (v29/v32) que o Google leu como link: não existem.
RewriteRule \$slug - [G,L]

# Cópias antigas em /pasta/index.html (v32, ainda no servidor) -> endereço oficial.
# THE_REQUEST garante que só pedidos diretos sejam redirecionados (não o DirectoryIndex da home).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/index\.html[\s?]
RewriteRule ^(.+)/index\.html$ /$1 [R=301,L]

# Endereço com barra no final -> sem barra
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Endereços antigos
RewriteRule ^nossos-momentos$ /galeria [R=301,L]
RewriteRule ^frios-finger-food$ /frios-e-finger-food [R=301,L]
RewriteRule ^38-anos-de-experi(e|ê|%C3%AA)ncia$ /o-dfaria [R=301,L,NC]

# Páginas: /eventos -> eventos.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Compressão GZIP (HTML, CSS, JS, JSON, SVG, XML)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>

# Cache longo para imagens, vídeos, fontes, CSS e JS
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 0 seconds"
ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# Cache-Control: arquivos versionados e mídia ficam imutáveis por 1 ano;
# HTML sempre revalida para receber atualizações.
<IfModule mod_headers.c>
# Streaming progressivo HTTP 206 para Vídeos da Hero
<FilesMatch "\.(mp4|webm|m4v)$">
Header set Accept-Ranges bytes
Header set Cache-Control "public, max-age=31536000, immutable"
Header set X-Content-Type-Options "nosniff"
</FilesMatch>

<FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(js|html?)$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>
</IfModule>

# Proteção de arquivos sensíveis (robots.txt e sitemap.xml continuam públicos)
<FilesMatch "(^\.|\.(log|sh|py|sql|bak)$)">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>
