# D'Faria Gastronomia e Eventos — configuração para HostGator (Apache)
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Sempre https e sem www (mesmo endereço oficial informado ao Google)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dfariagastronomia.com.br%{REQUEST_URI} [R=301,L,NE]

# Endereço com barra no final -> sem barra
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Endereços antigos
RewriteRule ^nossos-momentos$ /galeria [R=301,L]
RewriteRule ^frios-finger-food$ /frios-e-finger-food [R=301,L]
RewriteRule ^38-anos-de-experi(e|ê|%C3%AA)ncia$ /o-dfaria [R=301,L,NC]

# Páginas: /eventos -> eventos.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Compressão GZIP (HTML, CSS, JS, JSON, SVG, XML)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>

# Cache longo para imagens, vídeos, fontes, CSS e JS
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Cache-Control: arquivos versionados e mídia ficam imutáveis por 1 ano;
# HTML sempre revalida para receber atualizações.
<IfModule mod_headers.c>
# Streaming progressivo HTTP 206 para Vídeos da Hero
<FilesMatch "\.(mp4|webm|m4v)$">
Header set Accept-Ranges bytes
Header set Cache-Control "public, max-age=31536000, immutable"
Header set X-Content-Type-Options "nosniff"
</FilesMatch>

<FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html?$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

# Proteção de arquivos sensíveis (robots.txt e sitemap.xml continuam públicos)
<FilesMatch "(^\.|\.(log|sh|py|sql|bak)$)">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>
